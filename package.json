    "github-markdown-css": "^5.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vditor": "^3.11.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.4",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
